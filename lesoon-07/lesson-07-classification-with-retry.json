        "jsonBody": "={\n  \"systemInstruction\": {\n    \"parts\": [\n      {\n        \"text\": \"לכל פנייה קבע קטגוריה אחת ודחיפות אחת.\\n\\nקטגוריות:\\nמשלוח: הזמנה שכבר בוצעה ולא הגיעה, איחור, שינוי כתובת.\\nהחזרה: בקשה להחזיר או להחליף מוצר תקין.\\nתשלום: כל מה שקשור לכסף: חיוב, זיכוי, החזר כספי, חשבונית.\\nתקלה במוצר: מוצר שהגיע פגום, שבור או לא עובד.\\nשאלה מקדימה: שאלה של מי שעוד לא הזמין, גם אם היא על משלוח.\\n\\nדחיפות:\\nגבוהה: חיוב כפול או שגוי, או מוצר שמסוכן לשימוש (חשמל, אש, חום).\\nנמוכה: שאלה מקדימה.\\nרגילה: כל השאר.\\n\\nהנימוק: משפט אחד, עד 10 מילים.\"\n      }\n    ]\n  },\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": {{ JSON.stringify($json.query.text) }}\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"responseSchema\": {\n      \"type\": \"OBJECT\",\n      \"properties\": {\n        \"category\": {\n          \"type\": \"STRING\",\n          \"enum\": [\"משלוח\", \"החזרה\", \"תשלום\", \"תקלה במוצר\", \"שאלה מקדימה\"]\n        },\n        \"urgency\": {\n          \"type\": \"STRING\",\n          \"enum\": [\"גבוהה\", \"רגילה\", \"נמוכה\"]\n        },\n        \"reason\": {\n          \"type\": \"STRING\"\n        }\n      },\n      \"required\": [\"category\", \"urgency\", \"reason\"]\n    }\n  }\n}",
