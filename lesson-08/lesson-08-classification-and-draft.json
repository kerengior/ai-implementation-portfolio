        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"systemInstruction\": {\n    \"parts\": [\n      {\n        \"text\": \"לכל פנייה קבע קטגוריה אחת ודחיפות אחת.\\n\\nקטגוריות:\\nמשלוח: הזמנה שכבר בוצעה ולא הגיעה, איחור, שינוי כתובת.\\nהחזרה: בקשה להחזיר או להחליף מוצר תקין.\\nתשלום: כל מה שקשור לכסף: חיוב, זיכוי, החזר כספי, חשבונית.\\nתקלה במוצר: מוצר שהגיע פגום, שבור או לא עובד.\\nשאלה מקדימה: שאלה של מי שעוד לא הזמין, גם אם היא על משלוח.\\n\\nדחיפות:\\nגבוהה: חיוב כפול או שגוי, או מוצר שמסוכן לשימוש (חשמל, אש, חום).\\nנמוכה: שאלה מקדימה.\\nרגילה: כל השאר.\\n\\nהנימוק: משפט אחד, עד 10 מילים.\\n\\nטיוטת מענה: 2 עד 3 משפטים בעברית, בטון אדיב, בלשון רבים, למשל קיבלנו ונבדוק.\\nפותחים בתודה על הפנייה, או בהתנצלות אם משהו השתבש.\\nאסור להבטיח החזר כספי, זיכוי, פיצוי או מועד.\\nאסור להמציא מידע על מוצרים, מחירים או זמני משלוח. אם שואלים, כותבים שנציג יחזור עם תשובה.\\nבמוצר שמסוכן לשימוש: מבקשים להפסיק להשתמש בו מיד.\"\n      }\n    ]\n  },\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": {{ JSON.stringify($json[\"פנייה\"]) }}\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"responseSchema\": {\n      \"type\": \"OBJECT\",\n      \"properties\": {\n        \"category\": {\n          \"type\": \"STRING\",\n          \"enum\": [\"משלוח\", \"החזרה\", \"תשלום\", \"תקלה במוצר\", \"שאלה מקדימה\"]\n        },\n        \"urgency\": {\n          \"type\": \"STRING\",\n          \"enum\": [\"גבוהה\", \"רגילה\", \"נמוכה\"]\n        },\n        \"reason\": {\n          \"type\": \"STRING\"\n        },\n        \"draft_reply\": {\n          \"type\": \"STRING\"\n        }\n      },\n      \"required\": [\"category\", \"urgency\", \"reason\", \"draft_reply\"]\n    }\n  }\n}",
