    {
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst company = String(input.company ?? '').trim();\nconst rawId = String(input.submission_id ?? '').trim();\nconst providedId = rawId.toLowerCase() === 'none' ? '' : rawId;\nconst pad = v => String(v ?? '').trim().padStart(8, '0');\nconst rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nconst base = { company, caller_name: String(input.caller_name ?? ''), notes: String(input.notes ?? '') };\n\nif (providedId) {\n    if (!rows.some(r => pad(r.submission_id) === pad(providedId))) {\n    return [{ json: { ...base, result: 'single', submission_id: '', link_status: 'לא מקושר', options: [] } }];\n  }\n  return [{ json: { ...base, result: 'single', submission_id: pad(providedId), link_status: 'מקושר', options: [] } }];\n}\n\nconst needle = company.toLowerCase();\nconst found = needle\n  ? rows.filter(r => {\n      const c = String(r.company ?? '').trim().toLowerCase();\n      return c !== '' && (c.includes(needle) || needle.includes(c));\n    })\n  : [];\nconst byId = {};\nfor (const r of found) byId[pad(r.submission_id)] = r;\nconst matches = Object.values(byId);\n\nif (matches.length === 0) {\n  return [{ json: { ...base, result: 'single', submission_id: '', link_status: 'לא מקושר', options: [] } }];\n}\nif (matches.length === 1) {\n  return [{ json: { ...base, result: 'single', submission_id: pad(matches[0].submission_id), link_status: 'מקושר', options: [] } }];\n}\nreturn [{ json: { ...base, result: 'multiple', submission_id: '', link_status: '', options: matches.map(r => ({ submission_id: pad(r.submission_id), role: String(r.role ?? ''), submitted_at: String(r.submitted_at ?? '') })) } }];"
      },
